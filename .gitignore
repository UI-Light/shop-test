# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...but the example file is safe to commit (no real secrets in it)
!.env.local.example

# vercel
.vercel

# Android signing keys and build output.
# The .jks file is a private key - treat it exactly like .env.local and never
# commit it. Losing it means you can no longer ship updates to an already
# published app.
*.jks
*.keystore
twa/*.apk
twa/*.aab
twa/keystore.properties
android/

# typescript
*.tsbuildinfo
next-env.d.ts
