# Copy this file to .env.local and fill in the real values.
# .env.local is gitignored — never commit real secrets.

# Supabase — H1: Supabase dashboard → Project Settings → API
# The anon key is designed to be public (Row Level Security protects the data).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Mailgun — H3: server-side only.
# No NEXT_PUBLIC_ prefix, so these are never exposed to the browser.
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
